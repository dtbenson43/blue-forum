{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blue-forum",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FORUM",
        "class_name": "Forum"
      },
      {
        "name": "AGENTS",
        "class_name": "Agent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Forum"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Agent"]
    }
  ],
  "vars": {
    "AGENTS_ENABLED": "true",
    "OWNER_HANDLE": "overlord"
  }
}
